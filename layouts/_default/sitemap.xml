{{- /*
  Project override of themes/congo/layouts/_default/sitemap.xml (Congo 2.9.0).

  Two fixes over the theme version:
    1. Congo emits the self-referencing xhtml:link TWICE for every translated
       page (once inside the range, once after it).
    2. Congo emits no x-default at all. With French now at the site root and
       English moved under /en/, x-default pointing at the French version is
       what tells Google which version to serve when no language matches.

  Note also config.toml: sitemap entries are emitted per language, and
  robots.txt advertises the sitemap index at the domain root, which is what
  keeps a per-language sitemap allowed to list URLs outside its own directory.
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Data.Pages }}
    {{- if and
          (not (in (site.Params.sitemap.excludedKinds | default slice) .Kind))
          (.Param "xml" | default true)
          (not (isset .Params "externalUrl"))
          .Permalink }}
      <url>
        <loc>{{ .Permalink }}</loc>
        {{- if not .Lastmod.IsZero }}
        <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
        {{- end }}
        {{- with .Sitemap.ChangeFreq }}
        <changefreq>{{ . }}</changefreq>
        {{- end }}
        {{- if ge .Sitemap.Priority 0.0 }}
        <priority>{{ .Sitemap.Priority }}</priority>
        {{- end }}
        {{- with .AllTranslations }}
          {{- range . }}
        <xhtml:link rel="alternate" hreflang="{{ .Language.LanguageCode }}" href="{{ .Permalink }}" />
          {{- end }}
          {{- range . }}
            {{- if eq .Language.Lang "fr" }}
        <xhtml:link rel="alternate" hreflang="x-default" href="{{ .Permalink }}" />
            {{- end }}
          {{- end }}
        {{- end }}
      </url>
    {{- end }}
  {{- end }}
</urlset>
